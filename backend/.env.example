# Database
DATABASE_URL=postgresql+asyncpg://geotrack:geotrack@localhost:5432/geotrack_db
SYNC_DATABASE_URL=postgresql://geotrack:geotrack@localhost:5432/geotrack_db

# Google Earth Engine
GEE_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com
GEE_KEY_FILE=path/to/gee-key.json

# API Keys (optional)
OGD_API_KEY=your_ogd_india_api_key
BHUVAN_TOKEN=your_bhuvan_token
MAPBOX_TOKEN=your_mapbox_token

# App Settings
APP_NAME=GeoTrack India
APP_VERSION=1.0.0
DEBUG=True
CORS_ORIGINS=["http://localhost:3000"]
CACHE_TTL_SECONDS=3600

# Data paths
DATA_DIR=./data
CACHE_DIR=./cache
